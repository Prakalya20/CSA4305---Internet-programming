*{
margin:0;
padding:0;
box-sizing:border-box;
}


body{
font-family:Calibri,sans-serif;
background:#f7f7f7;
}


.container{
display:flex;
flex-wrap:wrap;
padding:20px;
gap:20px;
}


.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
flex:3;
gap:20px;
}


.card{
background:white;
padding:20px;
border-radius:10px;
box-shadow:0 2px 8px rgba(0,0,0,0.2);
}


.summary{
flex:1;
background:#fff3cd;
padding:20px;
border-radius:10px;
}


@media(max-width:768px){


.container{
flex-direction:column;
}


.summary{
width:100%;
}


}
