from flask import Flask, request, Response
import xml.etree.ElementTree as ET

app = Flask(__name__)

patients = {}

@app.route("/hospital", methods=["POST"])
def hospital_service():
    root = ET.fromstring(request.data)
    body = root.find(".//{*}Body")

    operation = list(body)[0]

    if operation.tag.endswith("addPatient"):
        p = operation
        pid = p.find(".//patientId").text
        name = p.find(".//name").text
        age = p.find(".//age").text

        patients[pid] = {"name": name, "age": age}

        result = f"<status>Patient {pid} added successfully</status>"

    elif operation.tag.endswith("getPatient"):
        pid = operation.find(".//patientId").text

        if pid in patients:
            p = patients[pid]
            result = f"""
            <patient>
                <id>{pid}</id>
                <name>{p['name']}</name>
                <age>{p['age']}</age>
            </patient>
            """
        else:
            result = "<error>Patient not found</error>"

    else:
        result = "<error>Invalid operation</error>"

    response = f"""
    <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
        <soap:Body>
            {result}
        </soap:Body>
    </soap:Envelope>
    """

    return Response(response, content_type="text/xml")


app.run(debug=True)
